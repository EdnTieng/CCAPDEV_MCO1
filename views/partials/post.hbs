<div class="post-item">
    <div class="post-header">
        <div class="user-icon"></div>
        <span class="username">{{username}}</span>
        <div class="post-options">
            <button class="options-btn" onclick="togglePostOptions({{id}})">⋮</button>
            <div class="options-menu" id="options-menu-{{id}}" style="display: none;">
                <button onclick="reportPost({{id}})">Report</button>
            </div>
        </div>
    </div>
    <div class="post-caption">
        <p>{{caption}}</p>
    </div>
    <div class="post-content">
        <img src="{{imageUrl}}" alt="Post image">
    </div>
    <div class="post-actions">
        <button id="like-btn-post-{{id}}" onclick="toggleLike('post', {{id}})">👍 Like</button>
        <button id="dislike-btn-post-{{id}}" onclick="toggleDislike('post', {{id}})">👎 Dislike</button>
        <button id="comment-btn-{{id}}" onclick="toggleComments({{id}})">💬 Comment</button>
    </div>

    <div class="comments-section" id="comments-{{id}}" style="display: none;">
        <div class="add-comment">
            <textarea placeholder="Add a comment..."></textarea>
            <button>Post Comment</button>
        </div>
        
        {{#each comments}}
            {{> comment}}
        {{/each}}
    </div>
</div>
